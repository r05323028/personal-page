---
import { resumeData } from '../data/resume';
import { Image } from 'astro:assets'
import avatar from '../assets/avatar.jpg';
import background from '../assets/background.jpg';

const { name, title, quote, contact } = resumeData;
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Image -->
  <div class="absolute inset-0">
    <Image 
      src={background} 
      alt="" 
      class="w-full h-full object-cover"
      quality="mid"
    />
  </div>
  
  <!-- Gradient Overlay -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary/90 via-secondary/85 to-accent/80"></div>
  
  <!-- Animated Background Elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-accent/20 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-64 h-64 bg-white/10 rounded-full blur-2xl"></div>
  </div>
  
  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
      <!-- Text Content -->
      <div class="flex-1 text-center lg:text-left">
        <p class="hero-subtitle text-blue-300 font-medium text-lg mb-4 opacity-0">Welcome to my portfolio</p>
        
        <h1 class="hero-title text-4xl md:text-5xl lg:text-6xl font-space font-bold text-white mb-6 opacity-0">
          Hi, I'm <span class="text-blue-300">{name}</span>
        </h1>
        
        <p class="hero-role text-xl md:text-2xl text-gray-300 mb-4 opacity-0">
          {title}
        </p>
        
        <p class="hero-quote text-gray-400 italic max-w-lg mx-auto lg:mx-0 mb-8 opacity-0">
          "{quote}"
        </p>
        
        <p class="hero-desc text-gray-400 max-w-lg mx-auto lg:mx-0 mb-8 opacity-0">
          Software Engineer specializing in workflow orchestration, distributed systems, and data-intensive applications. Currently building scalable systems at TSMC.
        </p>
        
        <!-- CTA Buttons -->
        <div class="hero-cta flex flex-wrap justify-center lg:justify-start gap-4 opacity-0">
          <a 
            href="#projects" 
            class="px-8 py-3 bg-blue-500 text-white font-medium rounded-full hover:bg-blue-600 transition-all hover:scale-105"
          >
            View My Work
          </a>
          <a 
            href="/resume" 
            class="px-8 py-3 border-2 border-white text-white font-medium rounded-full hover:bg-white hover:text-gray-900 transition-all"
          >
            View Resume
          </a>
        </div>
        
        <!-- Social Links -->
        <div class="hero-social flex flex-wrap justify-center lg:justify-start gap-4 mt-8 opacity-0">
          <a href={contact.github} target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="text-white/60 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
          <a href={`mailto:${contact.email}`} class="text-white/60 hover:text-white transition-colors">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </a>
        </div>
      </div>
      
      <!-- Profile Photo -->
      <div class="shrink-0 hero-photo opacity-0">
        <div class="relative">
          <div class="absolute inset-0 bg-accent rounded-full blur-2xl opacity-30 animate-pulse"></div>
          <div class="relative w-64 h-64 md:w-80 md:h-80 rounded-full overflow-hidden border-4 border-white/20 shadow-2xl">
            <Image src={avatar} alt="Profile Photo" class="w-full h-full object-cover" />
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 scroll-indicator opacity-0">
    <a href="#projects" class="flex flex-col items-center text-white/60 hover:text-white transition-colors">
      <span class="text-sm mb-2">Scroll to explore</span>
      <svg class="w-6 h-6 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </a>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  if (!prefersReducedMotion) {
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    
    tl.to('.hero-subtitle', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      delay: 0.2
    })
    .to('.hero-title', {
      opacity: 1,
      y: 0,
      duration: 0.8
    }, '-=0.5')
    .to('.hero-role', {
      opacity: 1,
      y: 0,
      duration: 0.8
    }, '-=0.5')
    .to('.hero-quote', {
      opacity: 1,
      y: 0,
      duration: 0.8
    }, '-=0.5')
    .to('.hero-desc', {
      opacity: 1,
      y: 0,
      duration: 0.8
    }, '-=0.5')
    .to('.hero-cta', {
      opacity: 1,
      y: 0,
      duration: 0.8
    }, '-=0.5')
    .to('.hero-social', {
      opacity: 1,
      y: 0,
      duration: 0.8
    }, '-=0.5')
    .to('.hero-photo', {
      opacity: 1,
      scale: 1,
      duration: 1
    }, '-=0.8')
    .to('.scroll-indicator', {
      opacity: 1,
      y: 0,
      duration: 0.8
    }, '-=0.3');
    
    gsap.set('.hero-subtitle, .hero-title, .hero-role, .hero-quote, .hero-desc, .hero-cta, .hero-social, .scroll-indicator', {
      y: 30
    });
    gsap.set('.hero-photo', {
      scale: 0.8
    });
  } else {
    document.querySelectorAll('.hero-subtitle, .hero-title, .hero-role, .hero-quote, .hero-desc, .hero-cta, .hero-social, .hero-photo, .scroll-indicator').forEach(el => {
      el?.classList.remove('opacity-0');
    });
  }
</script>
