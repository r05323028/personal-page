---
export interface Props {
  title: string;
  description: string;
  cover: string;
  tags: string[];
  github?: string;
  live?: string;
  category: string;
}

const { title, description, cover, tags, github, live, category } = Astro.props;
---

<article class="project-card group relative overflow-hidden rounded-2xl bg-white shadow-lg cursor-pointer opacity-0" data-category={category}>
  <!-- Image -->
  <div class="relative aspect-[4/3] overflow-hidden">
    <img 
      src={cover} 
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
      loading="lazy"
    />
    
    <!-- Hover Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-primary via-primary/80 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
      <h3 class="text-xl font-space font-bold text-white mb-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
        {title}
      </h3>
      
      <p class="text-gray-300 text-sm mb-4 line-clamp-2 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-75">
        {description}
      </p>
      
      <!-- Tags -->
      <div class="flex flex-wrap gap-2 mb-4 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-100">
        {tags.slice(0, 3).map(tag => (
          <span class="px-3 py-1 bg-accent/20 text-accent text-xs rounded-full">
            {tag}
          </span>
        ))}
      </div>
      
      <!-- Links -->
      <div class="flex gap-3 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-150">
        {live && (
          <a 
            href={live}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2 bg-accent text-white text-sm rounded-full hover:bg-accent/90 transition-colors"
            onclick="event.stopPropagation()"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Live Demo
          </a>
        )}
        
        {github && (
          <a 
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-4 py-2 border border-white text-white text-sm rounded-full hover:bg-white hover:text-primary transition-colors"
            onclick="event.stopPropagation()"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            Code
          </a>
        )}
      </div>
    </div>
  </div>
  
  <!-- Category Badge -->
  <div class="absolute top-4 left-4">
    <span class="px-3 py-1 bg-white/90 backdrop-blur-sm text-primary text-xs font-medium rounded-full capitalize">
      {category}
    </span>
  </div>
</article>

<style>
  .project-card {
    break-inside: avoid;
    margin-bottom: 1.5rem;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
