---
import ProjectCard from './ProjectCard.astro';
import eyesBrand from '../assets/eyes_brand.jpg';
import kkmeet from '../assets/kkmeet.jpg';
import type { ImageMetadata } from 'astro';

interface Project {
  title: string;
  description: string;
  cover: string | ImageMetadata;
  tags: string[];
  category: string;
  github?: string;
}

// Projects from CV
const projects: Project[] = [
  {
    title: "Eyes",
    description: "Eyes is a public opinion mining system focusing on Taiwanese forums such as PTT, Dcard. Built with React, FastAPI, GraphQL, and Kubernetes.",
    cover: eyesBrand,
    tags: ["React", "GraphQL", "FastAPI", "Kubernetes", "Helm", "spaCy"],
    category: "web",
    github: "https://github.com/r05323028/eyes"
  },
  {
    title: "KKMeet",
    description: "KKMeet is a social network app based on music recommendation. Won 3rd place in KKBOX inhouse hackathon 2019.",
    cover: kkmeet,
    tags: ["React Native", "Flask", "User-User CF"],
    category: "mobile"
  },
  {
    title: "TTS Recorder",
    description: "A human labeling tool for Text-to-speech training data collecting. Built for KKLAB's voice synthesis projects.",
    cover: "https://images.unsplash.com/photo-1590602847861-f357a9332bbc?w=800&h=600&fit=crop",
    tags: ["React", "FastAPI", "PostgreSQL"],
    category: "web"
  },
  {
    title: "KKBOX Opinion Mining",
    description: "Public opinion mining system using novel NLP models. Sold as SAAS to other companies.",
    cover: "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=800&h=600&fit=crop",
    tags: ["Python", "NLP", "spaCy", "TensorFlow"],
    category: "web"
  }
];

const categories = ['all', 'web', 'mobile'];
---

<section id="projects" class="py-24 bg-background">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="section-title text-4xl md:text-5xl font-space font-bold text-primary mb-4 opacity-0">
        Featured Projects
      </h2>
      <p class="section-desc text-lg text-secondary max-w-2xl mx-auto opacity-0">
        A selection of projects I've worked on at KKLab and personal open-source work.
      </p>
    </div>
    
    <!-- Category Filter -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      {categories.map(category => (
        <button 
          class="filter-btn px-6 py-2 rounded-full border-2 border-secondary text-secondary font-medium transition-all hover:bg-primary hover:text-white hover:border-primary capitalize opacity-0"
          data-category={category}
        >
          {category}
        </button>
      ))}
    </div>
    
    <!-- Projects Masonry Grid -->
    <div class="projects-masonry columns-1 md:columns-2 lg:columns-3 gap-6 space-y-6">
      {projects.map((project) => (
        <ProjectCard 
          title={project.title}
          description={project.description}
          cover={project.cover}
          tags={project.tags}
          github={project.github}
          category={project.category}
        />
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  
  gsap.registerPlugin(ScrollTrigger);
  
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  
  if (!prefersReducedMotion) {
    gsap.to('.section-title', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.section-title',
        start: 'top 80%',
        toggleActions: 'play none none reverse'
      }
    });
    
    gsap.to('.section-desc', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.section-desc',
        start: 'top 80%',
        toggleActions: 'play none none reverse'
      }
    });
    
    gsap.set('.section-title, .section-desc', { y: 30 });
    
    gsap.to('.filter-btn', {
      opacity: 1,
      y: 0,
      duration: 0.6,
      stagger: 0.1,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.filter-btn',
        start: 'top 85%',
        toggleActions: 'play none none reverse'
      }
    });
    
    gsap.set('.filter-btn', { y: 20 });
    
    gsap.to('.project-card', {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.15,
      ease: 'power3.out',
      scrollTrigger: {
        trigger: '.projects-masonry',
        start: 'top 75%',
        toggleActions: 'play none none reverse'
      }
    });
    
    gsap.set('.project-card', { y: 50 });
  } else {
    document.querySelectorAll('.section-title, .section-desc, .filter-btn, .project-card').forEach(el => {
      el?.classList.remove('opacity-0');
    });
  }
  
  const filterBtns = document.querySelectorAll('.filter-btn');
  const projectCards = document.querySelectorAll('.project-card');
  
  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const category = btn.getAttribute('data-category');
      
      filterBtns.forEach(b => {
        b.classList.remove('bg-primary', 'text-white', 'border-primary');
        b.classList.add('text-secondary', 'border-secondary');
      });
      btn.classList.remove('text-secondary', 'border-secondary');
      btn.classList.add('bg-primary', 'text-white', 'border-primary');
      
      projectCards.forEach(card => {
        const cardCategory = card.getAttribute('data-category');
        
        if (category === 'all' || cardCategory === category) {
          gsap.to(card, {
            opacity: 1,
            scale: 1,
            duration: 0.4,
            display: 'block'
          });
        } else {
          gsap.to(card, {
            opacity: 0,
            scale: 0.9,
            duration: 0.4,
            onComplete: () => {
              (card as HTMLElement).style.display = 'none';
            }
          });
        }
      });
    });
  });
  
  if (filterBtns.length > 0) {
    filterBtns[0].classList.add('bg-primary', 'text-white', 'border-primary');
    filterBtns[0].classList.remove('text-secondary', 'border-secondary');
  }
</script>

<style>
  .projects-masonry {
    column-fill: balance;
  }
</style>
