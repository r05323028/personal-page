---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { getCollection, render } from 'astro:content';

const blogPosts = await getCollection('blog');

// Render each post
const renderedPosts = await Promise.all(
  blogPosts.map(async (post) => {
    const { Content } = await render(post);
    return { post, Content };
  })
);
---

<Layout title="Blog - Sean Chang">
  <Navigation />
  
  <main class="pt-24 pb-16 min-h-screen bg-background">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-space font-bold text-primary mb-4">
          Blog
        </h1>
        <p class="text-lg text-secondary max-w-2xl mx-auto">
          Insights on software engineering, data science, workflow orchestration, and building production systems.
        </p>
      </div>
      
      <!-- Blog Posts - Full Content -->
      <div class="space-y-16">
        {renderedPosts.map(({ post, Content }) => (
          <article id={`post-${post.data.slug || post.id}`} class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
            <!-- Post Header -->
            <div class="bg-gradient-to-br from-primary to-accent p-8 text-white">
              <div class="flex flex-wrap gap-2 mb-4">
                {post.data.tags.map((tag: string) => (
                  <span class="px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-sm font-medium rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
              
              <h2 class="text-2xl md:text-3xl font-space font-bold mb-2">
                {post.data.title}
              </h2>
              
              <div class="flex items-center gap-4 text-white/80 text-sm">
                <span>{new Date(post.data.date).toLocaleDateString()}</span>
                {post.data.readingTime && (
                  <>
                    <span>·</span>
                    <span>{post.data.readingTime}</span>
                  </>
                )}
              </div>
            </div>
            
            <!-- Post Content -->
            <div class="p-8">
              <p class="text-lg text-gray-600 mb-6 leading-relaxed">
                {post.data.description}
              </p>
              
              <div class="prose prose-lg max-w-none prose-headings:font-space prose-headings:text-primary prose-a:text-accent prose-a:no-underline hover:prose-a:underline">
                <Content />
              </div>
              
              <!-- Share/Actions -->
              <div class="mt-8 pt-6 border-t border-gray-100 flex items-center justify-between">
                <div class="flex items-center gap-4">
                  <span class="text-sm text-gray-500">Share:</span>
                  <button class="text-gray-400 hover:text-accent transition-colors" onclick={`navigator.clipboard.writeText(window.location.origin + '/blog#post-${post.data.slug || post.id}')`}>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                    </svg>
                  </button>
                </div>
                <a 
                  href={`#post-${post.data.slug || post.id}`}
                  class="text-accent font-medium hover:underline flex items-center gap-2"
                >
                  Permanent Link
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
      
      <!-- Newsletter/Subscribe Section -->
      <div class="mt-16 bg-primary rounded-2xl p-8 text-center text-white">
        <h3 class="text-2xl font-space font-bold mb-4">Stay Updated</h3>
        <p class="text-gray-300 mb-6">Follow me on GitHub or LinkedIn for the latest posts and projects.</p>
        <div class="flex justify-center gap-4">
          <a 
            href="https://github.com/r05323028" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 bg-white text-primary font-medium rounded-full hover:bg-gray-100 transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            GitHub
          </a>
          <a 
            href="https://linkedin.com/in/r05323028" 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-white text-white font-medium rounded-full hover:bg-white hover:text-primary transition-colors"
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>
