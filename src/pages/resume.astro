---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { resumeData } from '../data/resume';

const { name, title, quote, experience, education, skills, projects, honors, presentations, contact } = resumeData;
---

<Layout title={`Resume - ${name}`}>
  <Navigation />
  
  <main class="pt-24 pb-16 min-h-screen bg-background">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <div class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-space font-bold text-primary mb-2">
          {name}
        </h1>
        <p class="text-xl text-accent font-medium mb-2">{title}</p>
        <p class="text-lg text-secondary italic mb-6">"{quote}"</p>
        
        <div class="flex flex-wrap justify-center items-center gap-4 text-sm text-secondary mb-4">
          <span>{contact.location}</span>
          <span>·</span>
          <a href={`mailto:${contact.email}`} class="text-accent hover:underline">{contact.email}</a>
          <span>·</span>
          <span>{contact.phone}</span>
        </div>
        
        <div class="flex flex-wrap justify-center gap-4">
          <a href={contact.linkedin} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">LinkedIn</a>
          <a href={contact.github} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">GitHub</a>
          <a href={contact.website} target="_blank" rel="noopener noreferrer" class="text-accent hover:underline">Website</a>
        </div>
      </div>
      
      <!-- Experience Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-space font-bold text-primary mb-6 pb-2 border-b-2 border-accent">
          Work Experience
        </h2>
        
        <div class="space-y-8">
          {experience.map((job) => (
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <div>
                  <h3 class="text-xl font-space font-bold text-primary">{job.role}</h3>
                  <p class="text-secondary font-medium">{job.company}</p>
                </div>
                <div class="text-gray-500 text-sm mt-2 md:mt-0">
                  {job.startDate} - {job.endDate} · {job.location}
                </div>
              </div>
              
              <p class="text-gray-600 mb-3">{job.description}</p>
              
              {job.achievements && (
                <ul class="list-disc list-inside text-gray-600 mb-4 space-y-1">
                  {job.achievements.map(achievement => (
                    <li>{achievement}</li>
                  ))}
                </ul>
              )}
              
              <div class="flex flex-wrap gap-2">
                {job.technologies.map(tech => (
                  <span class="px-3 py-1 bg-gray-100 text-gray-700 text-sm rounded-full">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
      
      <!-- Projects Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-space font-bold text-primary mb-6 pb-2 border-b-2 border-accent">
          Projects
        </h2>
        
        <div class="space-y-6">
          {projects.map((project) => (
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <div class="flex items-center gap-3">
                  <h3 class="text-xl font-space font-bold text-primary">{project.name}</h3>
                  {project.github && (
                    <a href={project.github} target="_blank" rel="noopener noreferrer" class="text-accent hover:text-accent/80">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                      </svg>
                    </a>
                  )}
                </div>
                <div class="text-gray-500 text-sm mt-2 md:mt-0">
                  {project.period} · {project.location}
                </div>
              </div>
              
              <p class="text-secondary font-medium mb-2">{project.role}</p>
              <p class="text-gray-600 mb-4">{project.description}</p>
              
              <div class="flex flex-wrap gap-2">
                {project.technologies.map(tech => (
                  <span class="px-3 py-1 bg-accent/10 text-accent text-sm rounded-full">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
      
      <!-- Skills Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-space font-bold text-primary mb-6 pb-2 border-b-2 border-accent">
          Skills
        </h2>
        
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <h3 class="font-space font-bold text-primary mb-3">Programming</h3>
              <p class="text-gray-600">{skills.programming.join(", ")}</p>
            </div>
            <div>
              <h3 class="font-space font-bold text-primary mb-3">ML Frameworks</h3>
              <p class="text-gray-600">{skills.mlFrameworks.join(", ")}</p>
            </div>
            <div>
              <h3 class="font-space font-bold text-primary mb-3">Backend</h3>
              <p class="text-gray-600">{skills.backend.join(", ")}</p>
            </div>
            <div>
              <h3 class="font-space font-bold text-primary mb-3">Frontend</h3>
              <p class="text-gray-600">{skills.frontend.join(", ")}</p>
            </div>
            <div>
              <h3 class="font-space font-bold text-primary mb-3">DevOps</h3>
              <p class="text-gray-600">{skills.devops.join(", ")}</p>
            </div>
            <div>
              <h3 class="font-space font-bold text-primary mb-3">MLOps</h3>
              <p class="text-gray-600">{skills.mlops.join(", ")}</p>
            </div>
            <div>
              <h3 class="font-space font-bold text-primary mb-3">NLP</h3>
              <p class="text-gray-600">{skills.nlp.join(", ")}</p>
            </div>
            <div>
              <h3 class="font-space font-bold text-primary mb-3">Visualization</h3>
              <p class="text-gray-600">{skills.visualization.join(", ")}</p>
            </div>
          </div>
        </div>
      </section>
      
      <!-- Education Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-space font-bold text-primary mb-6 pb-2 border-b-2 border-accent">
          Education
        </h2>
        
        <div class="space-y-6">
          {education.map((edu) => (
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
              <div class="flex items-start gap-4">
                {edu.logo && (
                  <div class="flex-shrink-0 w-16 h-16 rounded-lg overflow-hidden bg-gray-50 flex items-center justify-center">
                    <img src={edu.logo} alt={edu.institution} class="w-full h-full object-contain" />
                  </div>
                )}
                <div class="flex-1">
                  <div class="flex flex-col md:flex-row md:items-center md:justify-between">
                    <div>
                      <h3 class="text-xl font-space font-bold text-primary">{edu.degree}</h3>
                      <p class="text-secondary">{edu.institution}</p>
                    </div>
                    <div class="text-gray-500 mt-2 md:mt-0">
                      {edu.year} · {edu.location}
                    </div>
                  </div>
                  {edu.thesis && (
                    <p class="text-gray-600 mt-2 text-sm">Thesis: {edu.thesis}</p>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>
      
      <!-- Honors Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-space font-bold text-primary mb-6 pb-2 border-b-2 border-accent">
          Honors & Awards
        </h2>
        
        <div class="space-y-4">
          {honors.map((honor) => (
            <div class="bg-white p-4 rounded-xl shadow-sm border border-gray-100 flex flex-col md:flex-row md:items-center md:justify-between">
              <div>
                <span class="inline-block px-3 py-1 bg-accent/10 text-accent text-sm font-medium rounded-full mb-2">
                  {honor.award}
                </span>
                <h3 class="font-space font-bold text-primary">{honor.event}</h3>
              </div>
              <div class="text-gray-500 text-sm mt-2 md:mt-0">
                {honor.location} · {honor.year}
              </div>
            </div>
          ))}
        </div>
      </section>
      
      <!-- Presentations Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-space font-bold text-primary mb-6 pb-2 border-b-2 border-accent">
          Presentations
        </h2>
        
        <div class="space-y-6">
          {presentations.map((presentation) => (
            <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-100">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-3">
                <div>
                  <span class="inline-block px-3 py-1 bg-accent/10 text-accent text-sm font-medium rounded-full mb-2">
                    {presentation.role}
                  </span>
                  <h3 class="text-xl font-space font-bold text-primary">{presentation.event}</h3>
                </div>
                <div class="text-gray-500 text-sm mt-2 md:mt-0">
                  {presentation.location} · {presentation.date}
                </div>
              </div>
              <ul class="list-disc list-inside text-gray-600 space-y-1">
                {presentation.topics.map(topic => (
                  <li>{topic}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
      
      <!-- Download Button -->
      <div class="text-center">
        <button 
          onclick="window.print()"
          class="inline-flex items-center gap-2 px-8 py-3 bg-primary text-white font-medium rounded-full hover:bg-primary/90 transition-all hover:scale-105"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
          Print / Save as PDF
        </button>
      </div>
    </div>
  </main>
  
  <Footer />
</Layout>

<style>
  @media print {
    nav, footer, button {
      display: none !important;
    }
    
    main {
      padding-top: 2rem !important;
    }
    
    .bg-white {
      box-shadow: none !important;
      border: 1px solid #e5e7eb !important;
      break-inside: avoid;
    }
    
    section {
      break-inside: avoid;
    }
  }
</style>
